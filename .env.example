# Copia este fichero a .env.local y ajusta los valores.

# --- Públicas (se incrustan en el bundle del navegador) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo servidor ---
# API propia de DeckForge (repositorio deckforge-api, Fase 2).
API_BASE_URL=http://localhost:4000

# Scryfall exige un User-Agent identificable y una cabecera Accept en cada petición.
SCRYFALL_API_URL=https://api.scryfall.com
SCRYFALL_USER_AGENT=DeckForge/0.1 (+https://github.com/tu-usuario/deckforge-web)
